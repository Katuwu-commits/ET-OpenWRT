		interrupt-map = <0x00 0x00 0x00 0x01 0x7d 0x00 0x00 0x00 0x00 0x02 0x7d 0x01 0x00 0x00 0x00 0x03 0x7d 0x02 0x00 0x00 0x00 0x04 0x7d 0x03>;
		#size-cells = <0x02>;
		interrupt-map-mask = <0x00 0x00 0x00 0x07>;
		compatible = "mediatek,mt6880-pcie";
		ranges = <0x82000000 0x00 0x00 0x00 0xc4000000 0x00 0x4000000>;
		#interrupt-cells = <0x01>;
		status = "okay";
		phys = <0x7c>;
		reg = <0x00 0x11290000 0x00 0x2000>;
		linux,pci-domain = <0x02>;
		phandle = <0x158>;

		legacy-interrupt-controller {
			#address-cells = <0x00>;
			#interrupt-cells = <0x01>;
			phandle = <0x7d>;
			interrupt-controller;
		};
	};

	dpmaif_ao@10014000 {
		compatible = "mediatek,dpmaif_ao";
		reg = <0x00 0x10014000 0x00 0x1000>;
	};
};
