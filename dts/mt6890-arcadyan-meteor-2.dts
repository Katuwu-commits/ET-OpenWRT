/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "MediaTek evb6890v1_64_cpe_nand";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "mediatek,evb6890v1_64_cpe_nand\0mediatek,mt6890";

	smi@14016000 {
		compatible = "mediatek,mt6880-smi-common";
		reg = <0x00 0x14016000 0x00 0x1000>;
		phandle = <0x86>;
	};

	rt1711_type_c_port0 {
		rt-tcpc,role_def = <0x04>;
		rt1711pd,intr_gpio_num = <0x28>;
		rt1711pd,intr_gpio = <0x02 0x28 0x00>;
		rt-tcpc,notifier_supply_num = <0x02>;
		rt-tcpc,vconn_supply = <0x01>;
		tcpc-dual,supported_modes = <0x00>;
		rt-tcpc,rp_level = <0x00>;
		rt-tcpc,name = "type_c_port0";
		phandle = <0x16d>;

		displayport {
			typec,receptacle;
			usbr20_not_used;
			signal,dp_v13;
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";

			dfp_d {
				pin_assignment,mode_f;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
				pin_assignment,mode_c;
			};

			ufp_d {
			};
		};

		dpm_caps {
			pr_check = <0x00>;
			attemp_discover_id;
			local_vconn_supply;
			local_usb_comm;
			attemp_enter_dp_mode;
			local_dr_power;
			local_no_suspend;
			dr_check = <0x00>;
			attemp_discover_cable;
			local_dr_data;
		};

		pd-data {
			pd,charging_policy = <0x31>;
			pd,pid = <0x1711>;
			pd,source-cap-ext = <0x171129cf 0x00 0x00 0x00 0x00 0x2000000>;
			pd,vid = <0x29cf>;
			pd,mfrs = "RichtekTCPC";
			pd,id-vdo-size = <0x03>;
			pd,source-pdo-size = <0x01>;
			pd,id-vdo-data = <0xd10029cf 0x00 0x17110000>;
			bat,nr = <0x01>;
			pd,source-pdo-data = <0x19032>;
			pd,sink-pdo-size = <0x01>;
			pd,sink-pdo-data = <0x190c8>;
			pd,country_nr = <0x00>;

			bat-info0 {
				bat,pid = <0x1711>;
				bat,design_cap = <0xbb8>;
				bat,vid = <0x29cf>;
				bat,mfrs = "bat1";
			};
		};
	};

	kp@10010000 {
		pinctrl-names = "default";
		mediatek,kpd-use-extend-type = <0x00>;
		pinctrl-0 = <0x41>;
		clock-names = "kpd";
		interrupts = <0x00 0x4a 0x01>;
